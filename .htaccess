Options -Indexes

RewriteEngine On

# If the request is for a directory without an index file, redirect to homepage.php
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index\.php !-f
RewriteRule ^.*$ /Webengineering/pages/homepage.php [R=302,L]

# Handle 404 errors - redirect to homepage
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /Webengineering/pages/homepage.php [R=302,L]

# Alternatively, you can use ErrorDocument for a cleaner approach
# ErrorDocument 404 /Webengineering/pages/homepage.php